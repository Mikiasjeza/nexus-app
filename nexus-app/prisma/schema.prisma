// Prisma schema for Nexus

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String   // Hashed password (bcrypt)
  avatar        String?
  bio           String?
  publicProfile Boolean  @default(false)
  shareableId   String   @unique @default(cuid())
  customSlug    String?  @unique
  emailVerified Boolean  @default(false)
  emailToken    String?  // For email verification
  resetToken    String?  // For password reset
  resetExpires  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  skills           Skill[]
  sessions         Session[]
  aiAnalyses       AIAnalysis[]
  activities       Activity[]
  subscriptions    Subscription[]
  oauthConnections OAuthConnection[]

  @@index([email])
  @@index([shareableId])
  @@index([customSlug])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Skill {
  id          String   @id @default(cuid())
  userId      String
  name        String
  level       String   // 'beginner' | 'intermediate' | 'advanced' | 'expert'
  category    String   // SkillCategory enum
  progress    Int      @default(0) // 0-100
  notes       String?
  description String?
  tags        String[] @default([])
  verified    Boolean  @default(false)
  order       Int      @default(0)
  visibility  String   @default("public") // 'public' | 'private'
  status      String   @default("published") // 'draft' | 'published'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence    Evidence[]
  history     SkillHistory[]
  aiAnalyses  AIAnalysis[]

  @@index([userId])
  @@index([visibility])
  @@index([status])
  @@index([category])
}

model Evidence {
  id          String   @id @default(cuid())
  skillId     String
  type        String   // 'video' | 'code' | 'portfolio' | 'certificate' | 'project' | 'file'
  url         String?
  fileUrl     String?  // S3/Cloudinary URL
  fileName    String?
  fileSize    Int?     // bytes
  mimeType    String?
  description String?
  metadata    Json?    // Additional metadata (e.g., GitHub repo info)
  createdAt   DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([type])
}

model SkillHistory {
  id        String   @id @default(cuid())
  skillId   String
  userId    String?
  timestamp DateTime @default(now())
  changes   Json     // Array of { field, oldValue, newValue }

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([timestamp])
}

model AIAnalysis {
  id              String   @id @default(cuid())
  skillId         String
  userId          String
  evidenceId      String?  // Optional: specific evidence analyzed
  model           String   // 'gpt-4', 'claude-3', etc.
  confidenceScore Float    // 0-1
  explanation     String   // Why this score
  suggestedLevel  String?  // AI-suggested skill level
  improvements    String[] @default([]) // Suggested improvements
  rawResponse     Json?    // Full AI response for debugging
  tokensUsed      Int?
  cost            Float?   // Cost in USD
  createdAt       DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([userId])
  @@index([createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'skill_added' | 'skill_updated' | 'skill_deleted' | 'level_up' | 'evidence_added'
  skillId   String?
  skillName String?
  message   String
  metadata  Json?    // Additional context
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([type])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  stripeCustomerId String?  @unique
  stripeSubscriptionId String? @unique
  plan              String   // 'free' | 'pro' | 'enterprise'
  status            String   // 'active' | 'canceled' | 'past_due' | 'trialing'
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  livemode    Boolean  @default(false)
  status      String   @default("processing") // 'processing' | 'processed' | 'failed'
  attempts    Int      @default(1)
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([createdAt])
}

model OAuthConnection {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // 'github' | 'google' | 'linkedin'
  providerId   String   // External provider's user ID
  accessToken  String?  // Encrypted
  refreshToken String?  // Encrypted
  expiresAt    DateTime?
  metadata     Json?    // Provider-specific data (e.g., GitHub username, repos)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider, providerId])
}
