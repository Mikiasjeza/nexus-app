DATABASE_URL="postgresql://user:password@localhost:5432/nexus?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"
GUEST_MODE="false"

# AI (skill verification, job matching, career chat)
# AI_PROVIDER is gemini, openai, anthropic or groq; only that provider's key is needed.
# groq has a free tier (OpenAI-compatible API) and defaults to llama-3.3-70b-versatile.
# AI_MODEL defaults to gemini-2.5-flash for gemini and claude-opus-5-5 for
# anthropic; it is required for openai.
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="AIza..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY=""
# Optional: price of AI_MODEL in USD per million tokens, for cost tracking.
# Claude models are priced automatically.
AI_INPUT_COST_PER_MTOK=""
AI_OUTPUT_COST_PER_MTOK=""

# Authentication
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (sign-in, and confirming authorship of linked repositories)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"
# Optional: a GitHub token with no scopes raises the rate limit for reading
# public repositories submitted as evidence (60 -> 5,000 requests an hour).
GITHUB_TOKEN=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."
# Set to "true" only after Stripe Tax is set up in the Stripe dashboard.
STRIPE_AUTOMATIC_TAX="false"

# Evidence file storage (AWS S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="nexus-uploads"

# Email (Resend)
EMAIL_FROM="noreply@nexus.ai"
CONTACT_EMAIL="support@nexus.ai"
RESEND_API_KEY="re_..."

# Monitoring (optional but recommended)
SENTRY_DSN=""

# Skill assessments (see docs/assessments.md)
# Reviewers: comma-separated emails of accounts that can open /admin/reviews.
ADMIN_EMAILS=""
# Python grading runs on Judge0. Either your own Judge0 CE server...
JUDGE0_URL=""
JUDGE0_AUTH_TOKEN=""
# ...or the Judge0 CE plan on RapidAPI (used when JUDGE0_URL is empty).
JUDGE0_RAPIDAPI_KEY=""
# Judge0's language id for Python 3 (71 on Judge0 CE).
JUDGE0_PYTHON_LANGUAGE_ID="71"
# Optional: run JavaScript and TypeScript on Judge0 too, instead of the
# in-process QuickJS sandbox. Use a Node 18+ id from your server's /languages.
JUDGE0_JAVASCRIPT_LANGUAGE_ID=""
