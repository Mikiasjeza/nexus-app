DATABASE_URL="postgresql://user:password@localhost:5432/nexus?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"
GUEST_MODE="false"

# AI (skill verification, job matching, career chat)
# AI_PROVIDER is gemini, openai, anthropic or groq; only that provider's key is needed.
# groq has a free tier (OpenAI-compatible API) and defaults to openai/gpt-oss-120b.
# AI_MODEL defaults to gemini-2.5-flash for gemini and claude-opus-5-5 for
# anthropic; it is required for openai.
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="AIza..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY=""
# Optional: price of AI_MODEL in USD per million tokens, for cost tracking.
# Claude models are priced automatically.
AI_INPUT_COST_PER_MTOK=""
AI_OUTPUT_COST_PER_MTOK=""

# Authentication
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Sign-in providers (see docs/SIGN_IN.md). A provider's button appears only when
# both of its values are set. Register this return address with each provider:
# <NEXT_PUBLIC_APP_URL>/api/auth/oauth/<google|microsoft|linkedin>/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional: common (default: work, school and personal accounts), organizations,
# consumers, or one tenant's id. Must agree with the app registration.
MICROSOFT_TENANT=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# GitHub OAuth: only for "Connect GitHub" in Settings, which confirms authorship
# of linked repositories. GitHub is not a way to sign in.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"
# Optional: a GitHub token with no scopes raises the rate limit for reading
# public repositories submitted as evidence (60 -> 5,000 requests an hour).
GITHUB_TOKEN=""

# Stripe (see docs/BILLING.md). Use test-mode keys everywhere except Production.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Monthly USD prices; each must cost exactly what lib/plans.ts says or checkout stays off.
STRIPE_PRO_PRICE_ID="price_..."
# Only needed once Career+ / Business go on sale.
STRIPE_CAREER_PLUS_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
# A live key (sk_live_) sells nothing until this is "true": the explicit go-ahead for real charges.
BILLING_LIVE_APPROVED="false"
# Optional: an existing portal configuration for plan changes (created automatically otherwise).
STRIPE_PORTAL_CONFIGURATION_ID=""
# Set to "true" only after Stripe Tax is set up in the Stripe dashboard.
STRIPE_AUTOMATIC_TAX="false"

# Cost controls: monthly AI budget in USD for alerts, and the secret Vercel Cron sends
# to /api/cron/billing-check.
AI_MONTHLY_BUDGET_USD=""
CRON_SECRET=""

# Evidence file storage (AWS S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="nexus-uploads"

# Email (Resend)
EMAIL_FROM="noreply@nexus.ai"
CONTACT_EMAIL="support@nexus.ai"
RESEND_API_KEY="re_..."

# Monitoring (optional but recommended)
SENTRY_DSN=""

# Skill assessments (see docs/assessments.md)
# Admins: comma-separated emails of accounts that can open /admin (every user's
# record, billing and the review queue). An address only counts once it is
# confirmed; see docs/SIGN_IN.md.
ADMIN_EMAILS=""
# Code runs on your own runner: the free Nexus runner (infra/runner) or Judge0
# (infra/judge0). Both use these two settings...
JUDGE0_URL=""
JUDGE0_AUTH_TOKEN=""
# ...or the Judge0 CE plan on RapidAPI (used when JUDGE0_URL is empty).
JUDGE0_RAPIDAPI_KEY=""
# Judge0 calls per UTC day before runs pause (grading gets 20% extra).
JUDGE0_DAILY_LIMIT="1000"
# In production all candidate code (Python, JavaScript, TypeScript, SQL) runs
# on this server; without it those assessments stay closed.
# Language ids are detected from the server (newest Python 3, newest Node 18+).
# Set these only to pin a specific version.
JUDGE0_PYTHON_LANGUAGE_ID=""
JUDGE0_JAVASCRIPT_LANGUAGE_ID=""
# Local development only: "pyodide" runs Python without Judge0. Never in production.
ASSESSMENT_DEV_PYTHON=""
