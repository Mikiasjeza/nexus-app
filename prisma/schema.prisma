// Prisma schema for Nexus

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  name                    String
  passwordHash            String // Hashed password (bcrypt)
  avatar                  String?
  bio                     String?
  publicProfile           Boolean   @default(false)
  shareableId             String    @unique @default(cuid())
  customSlug              String?   @unique
  emailVerified           Boolean   @default(false)
  emailToken              String? // For email verification
  resetToken              String? // For password reset
  resetExpires            DateTime?
  onboardingComplete      Boolean   @default(false)
  discoverableByEmployers Boolean   @default(false)
  // Two-step login: secret encrypted (lib/auth/totp.ts); pending until enabledAt is set.
  twoFactorSecret         String?
  twoFactorEnabledAt      DateTime?
  twoFactorLastStep       Int? // last accepted 30-second step, so a code works once
  twoFactorRecoveryCodes  String[]  @default([]) // SHA-256 hashes of unused codes
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  skills            Skill[]
  companyMembers    CompanyMember[]
  sessions          Session[]
  aiAnalyses        AIAnalysis[]
  activities        Activity[]
  subscriptions     Subscription[]
  oauthConnections  OAuthConnection[]
  AssessmentAttempt AssessmentAttempt[]
  Credential        Credential[]
  AssessmentAppeal  AssessmentAppeal[]
  usagePeriods      UsagePeriod[]
  promotions        PromotionRedemption[]
  waitlistEntries   WaitlistEntry[]
  reportsFiled      Report[]
  jobApplications   JobApplication[]
  notifications     Notification[]
  passportViews     PassportView[]
  careerProfile     CareerProfile?
  educationRecords  EducationRecord[]
  workExperiences   WorkExperience[]
  certifications    CertificationRecord[]
  conversations     Conversation[]

  @@index([email])
  @@index([shareableId])
  @@index([customSlug])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Skill {
  id          String   @id @default(cuid())
  userId      String
  name        String
  level       String // 'beginner' | 'intermediate' | 'advanced' | 'expert'
  category    String // SkillCategory enum
  progress    Int      @default(0) // 0-100
  notes       String?
  description String?
  tags        String[] @default([])
  verified    Boolean  @default(false)
  order       Int      @default(0)
  visibility  String   @default("public") // 'public' | 'private'
  status      String   @default("published") // 'draft' | 'published'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence   Evidence[]
  history    SkillHistory[]
  aiAnalyses AIAnalysis[]

  @@index([userId])
  @@index([visibility])
  @@index([status])
  @@index([category])
}

model Evidence {
  id          String   @id @default(cuid())
  skillId     String
  type        String // 'video' | 'code' | 'portfolio' | 'certificate' | 'project' | 'file'
  url         String?
  fileUrl     String? // S3/Cloudinary URL
  fileName    String?
  fileSize    Int? // bytes
  mimeType    String?
  description String?
  metadata    Json? // Additional metadata (e.g., GitHub repo info)
  createdAt   DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([type])
}

model SkillHistory {
  id        String   @id @default(cuid())
  skillId   String
  userId    String?
  timestamp DateTime @default(now())
  changes   Json // Array of { field, oldValue, newValue }

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([timestamp])
}

model AIAnalysis {
  id              String   @id @default(cuid())
  skillId         String
  userId          String
  evidenceId      String? // Optional: specific evidence analyzed
  model           String // 'gpt-4', 'claude-3', etc.
  confidenceScore Float // 0-1
  explanation     String // Why this score
  suggestedLevel  String? // AI-suggested skill level
  improvements    String[] @default([]) // Suggested improvements
  tokensUsed      Int?
  cost            Float? // Cost in USD
  createdAt       DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([userId])
  @@index([createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String // 'skill_added' | 'skill_updated' | 'skill_deleted' | 'level_up' | 'evidence_added'
  skillId   String?
  skillName String?
  message   String
  metadata  Json? // Additional context
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([type])
}

/// A person's or an organization's plan. Exactly one of userId and companyId is set
/// (a CHECK constraint in the migration enforces it). Stripe is the source of truth;
/// webhooks and checkout confirmation copy its state here (lib/billing/sync.ts).
model Subscription {
  id                   String    @id @default(cuid())
  userId               String?   @unique
  companyId            String?   @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 String // 'free' | 'pro' | 'career_plus' | 'business'
  status               String // Stripe's status: 'active' | 'trialing' | 'past_due' | 'unpaid' | 'incomplete' | 'incomplete_expired' | 'canceled' | 'paused'
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  promotionId          String? // promotion whose price applies to this subscription
  discountEndsAt       DateTime? // when the promotional price ends
  firstPaidAt          DateTime? // first time this account held a paid plan
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

/// One row per account per calendar month (UTC): the allowance that applied and what was used.
model UsagePeriod {
  id             String   @id @default(cuid())
  userId         String?
  companyId      String?
  periodStart    DateTime // first day of the month, 00:00 UTC
  periodEnd      DateTime // first day of the next month
  plan           String // plan whose limit applied when this row was last updated
  formalLimit    Int
  formalStarted  Int      @default(0) // formal assessments started (never decreases)
  formalUsed     Int      @default(0) // counted against the allowance (system failures are given back)
  practiceRounds Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  UsageEvent[]

  @@unique([userId, periodStart])
  @@unique([companyId, periodStart])
  @@index([periodStart])
}

/// Allowance ledger: one row per assessment attempt, so a retried start never counts twice.
model UsageEvent {
  id            String    @id @default(cuid())
  usagePeriodId String
  userId        String?
  companyId     String?
  kind          String // 'formal_assessment' | 'sponsored_assessment'
  attemptId     String    @unique
  status        String    @default("consumed") // 'consumed' | 'released'
  reason        String? // why it was given back
  createdAt     DateTime  @default(now())
  releasedAt    DateTime?

  usagePeriod UsagePeriod @relation(fields: [usagePeriodId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Early-adopter pricing, controlled by admins. Eligibility is decided on the server at checkout.
model Promotion {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. 'founding-pro'
  name           String
  planId         String // the plan it discounts
  priceCents     Int // promotional monthly price
  durationMonths Int // months the promotional price lasts
  maxRedemptions Int? // null = no cap
  startsAt       DateTime?
  endsAt         DateTime? // admin-controlled end date; null = no end date
  active         Boolean   @default(false)
  stripeCouponId String? // the Stripe coupon that applies it, once created
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  redemptions PromotionRedemption[]
}

/// One per promotion per person, so a promotion can't be applied twice.
model PromotionRedemption {
  id                   String    @id @default(cuid())
  promotionId          String
  userId               String
  status               String    @default("pending") // 'pending' | 'redeemed' | 'expired'
  checkoutSessionId    String?   @unique
  stripeSubscriptionId String?
  expiresAt            DateTime? // a pending reservation lapses with its checkout session
  createdAt            DateTime  @default(now())
  redeemedAt           DateTime?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promotionId, userId])
  @@index([promotionId, status])
}

/// People who asked to hear when a plan that isn't on sale yet opens.
model WaitlistEntry {
  id          String   @id @default(cuid())
  plan        String // 'career_plus' | 'business'
  userId      String
  companyName String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([plan, userId])
  @@index([plan])
}

model StripeWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  livemode    Boolean   @default(false)
  status      String    @default("processing") // 'processing' | 'processed' | 'failed'
  attempts    Int       @default(1)
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([createdAt])
}

model Company {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  website     String?
  description String?
  /// Verified badge: set when the owner's confirmed work email matches the website, or by an admin.
  verifiedAt  DateTime?
  verifiedVia String? // 'domain' | 'admin'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members       CompanyMember[]
  invites       CompanyInvite[]
  conversations Conversation[]
  jobListings   JobListing[]
  talentPools   TalentPool[]
  subscriptions Subscription[]
  usagePeriods  UsagePeriod[]

  @@index([slug])
}

model CompanyMember {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String // 'owner' | 'admin' | 'recruiter' | 'viewer'
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model JobListing {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  description String?
  skills      String[] // Required skills
  location    String?
  type        String // full-time, part-time, contract, internship
  status      String   @default("active")
  salary      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([companyId])
  @@index([status])
}

model TalentPool {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  candidateIds String[] @default([]) // User IDs saved to this pool
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model OAuthConnection {
  id         String    @id @default(cuid())
  userId     String
  provider   String // 'github' | 'google' | 'linkedin'
  providerId String // External provider's user ID
  // No provider tokens are stored: they're used once at sign-in and discarded.
  expiresAt  DateTime?
  metadata   Json? // Provider-specific data (e.g., GitHub username, repos)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider, providerId])
}

// ─── Skill assessments (see docs/assessments.md) ──────────────────────────

model AssessmentAttempt {
  id               String    @id @default(cuid())
  userId           String
  assessmentSlug   String // catalog slug, e.g. 'javascript'
  challengeId      String
  challengeVersion Int
  rubricId         String
  rubricVersion    Int
  mode             String // 'independent' | 'ai_assisted'
  seed             Int // server-side; generates this attempt's data and hidden tests
  status           String    @default("CREATED") // see lib/assessments/state.ts
  stage            String    @default("main") // 'main' | 'followup' | 'explain'
  drafts           Json      @default("{}") // autosaved work per stage
  runCount         Int       @default(0)
  result           String? // 'PASSED' | 'NOT_PASSED' | 'INCONCLUSIVE' | 'PENDING_REVIEW'
  score            Int? // 0-100
  startedAt        DateTime?
  deadlineAt       DateTime?
  submittedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      AttemptEvent[]
  submissions AssessmentSubmission[]
  evaluations AssessmentEvaluation[]
  credential  Credential?
  appeals     AssessmentAppeal[]

  @@index([userId, assessmentSlug])
  @@index([status])
}

/// Append-only log of what happened during an attempt (saves, runs, pastes, focus changes).
model AttemptEvent {
  id        String   @id @default(cuid())
  attemptId String
  type      String
  stage     String
  data      Json?
  at        DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, at])
}

/// One locked submission per stage; never updated after insert.
model AssessmentSubmission {
  id          String   @id @default(cuid())
  attemptId   String
  stage       String
  payload     Json
  contentHash String // sha-256 of the payload
  submittedAt DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, stage])
}

/// Every scoring pass (system or reviewer); the newest is current.
model AssessmentEvaluation {
  id            String   @id @default(cuid())
  attemptId     String
  rubricId      String
  rubricVersion Int
  criteria      Json
  score         Int?
  result        String
  feedback      Json
  integrity     Json
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  aiCostUsd     Float? // estimated cost of the AI grading call
  evaluatedBy   String // 'system' or the reviewer's email
  createdAt     DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
}

model Credential {
  id               String    @id // public id, e.g. NX-7K2M-9QXD-4FTA
  userId           String
  attemptId        String    @unique
  assessmentSlug   String
  skillName        String
  level            String
  mode             String
  identityLevel    String    @default("A_SELF_ASSERTED")
  score            Int
  rubricId         String
  rubricVersion    Int
  challengeId      String
  challengeVersion Int
  status           String    @default("ACTIVE") // 'ACTIVE' | 'REVOKED' | 'SUPERSEDED' (expiry is read from expiresAt)
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assessmentSlug])
}

model AssessmentAppeal {
  id         String    @id @default(cuid())
  attemptId  String
  userId     String
  reason     String
  status     String    @default("OPEN") // 'OPEN' | 'UPHELD' | 'REJECTED'
  resolution String?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([status])
}

/// Who did what to assessment records: reviews, appeals, revocations.
model AuditLog {
  id         String   @id @default(cuid())
  actor      String // user id, reviewer email or 'system'
  action     String
  targetType String
  targetId   String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// Calls to the external code runner per UTC day, for the daily spending cap.
model RunnerUsage {
  day       String   @id // YYYY-MM-DD, UTC
  calls     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Something a signed-in person flagged for review: a profile, job or company.
model Report {
  id         String    @id @default(cuid())
  reporterId String?
  targetType String // 'profile' | 'job' | 'company'
  targetId   String
  reason     String // 'spam' | 'fake' | 'offensive' | 'scam' | 'copyright' | 'other'
  details    String?
  status     String    @default("open") // 'open' | 'actioned' | 'dismissed'
  resolvedBy String? // admin email
  resolution String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  reporter User? @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

/// A candidate's application to a job listing. Applying shares their passport with the company.
model JobApplication {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  message   String?
  status    String   @default("submitted") // 'submitted' | 'shortlisted' | 'rejected' | 'withdrawn'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job  JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId, status])
}

/// An emailed invitation to join a company's employer account. Only the token's hash is stored.
model CompanyInvite {
  id         String    @id @default(cuid())
  companyId  String
  email      String
  role       String // 'admin' | 'recruiter' | 'viewer'
  tokenHash  String    @unique
  invitedBy  String // user id
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

/// Something that happened that a person should know about, shown under the bell.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // 'shortlisted' | 'saved' | 'passport_view' | 'applied' | 'message'
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// A private thread between a company (any of its team) and one candidate.
model Conversation {
  id              String    @id @default(cuid())
  companyId       String
  candidateId     String
  createdAt       DateTime  @default(now())
  lastMessageAt   DateTime  @default(now())
  companyReadAt   DateTime?
  candidateReadAt DateTime?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate User      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([companyId, candidateId])
  @@index([candidateId, lastMessageAt])
  @@index([companyId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String // user id; their side is whether they're the candidate
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// One view of a person's public Skill Passport, for their Career+ insights.
/// No IP address or visitor identity is kept; only whether the viewer was
/// signed in to a company account, and which company.
model PassportView {
  id        String   @id @default(cuid())
  userId    String
  companyId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A person's career profile: interests, goals and job preferences, plus where
/// they are in onboarding. Private: never shown to employers or the public.
model CareerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  employmentStatus    String?
  currentlyStudent    Boolean?
  yearsExperience     Int?
  interests           String[] @default([])
  exploring           Boolean  @default(false)
  desiredTitles       String[] @default([])
  longTermGoal        String?
  targetCareer        String?
  targetSkills        String[] @default([])
  progression         String?
  locations           String[] @default([])
  workArrangements    String[] @default([])
  salaryMin           Int?
  salaryMax           Int?
  salaryCurrency      String   @default("USD")
  jobTypes            String[] @default([])
  experienceLevels    String[] @default([])
  willingToRelocate   Boolean?
  preferredIndustries String[] @default([])
  availability        String?
  onboardingStep      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Education the person entered. Completed and in-progress are kept apart by
/// status; verification stays "self_reported" unless Nexus checks it.
model EducationRecord {
  id             String    @id @default(cuid())
  userId         String
  institution    String?
  level          String
  fieldOfStudy   String?
  status         String
  startDate      DateTime?
  graduationDate DateTime?
  verification   String    @default("self_reported")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Jobs, internships, apprenticeships, freelance and volunteer work the person entered.
model WorkExperience {
  id             String    @id @default(cuid())
  userId         String
  employer       String
  title          String
  industry       String?
  employmentType String
  startDate      DateTime?
  endDate        DateTime?
  current        Boolean   @default(false)
  description    String?
  verification   String    @default("self_reported")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Certifications and professional licenses the person entered.
model CertificationRecord {
  id             String    @id @default(cuid())
  userId         String
  name           String
  issuer         String?
  kind           String    @default("certification")
  issueDate      DateTime?
  expirationDate DateTime?
  verification   String    @default("self_reported")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A real job listing synced daily from a public source (USAJOBS, Greenhouse,
/// Lever). Never invented: every row links to the original posting.
model ExternalJob {
  id              String    @id @default(cuid())
  source          String // 'usajobs' | 'greenhouse' | 'lever'
  sourceId        String
  dedupeKey       String // normalized title|company|location, to drop duplicates across sources
  title           String
  company         String
  location        String?
  remote          Boolean   @default(false)
  salaryMin       Int?
  salaryMax       Int?
  salaryText      String?
  employmentType  String? // 'full-time' | 'part-time' | 'contract' | 'internship'
  experienceLevel String? // 'internship' | 'entry' | 'mid' | 'senior'
  description     String
  skills          String[]  @default([])
  /// Structured requirements parsed from the text: education, years, certifications, equivalence, work authorization.
  requirements    Json?
  applyUrl        String
  postedAt        DateTime?
  expiresAt       DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  active          Boolean   @default(true)

  @@unique([source, sourceId])
  @@index([active, postedAt])
  @@index([dedupeKey])
}
